# ── Database ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=affiliate_platform
DB_USER=affiliate_user
DB_PASSWORD=your_secure_password

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Models (Priority: Ollama → Replicate → OpenRouter → Gemini) ──
GEMINI_API_KEY=your_gemini_api_key
GEMINI_FALLBACK_KEY=your_gemini_fallback_key
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OLLAMA_HOST=http://localhost:11434

# ── Telegram ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel

# ── Amazon Affiliate ───────────────────────────────────
AMAZON_ASSOCIATE_TAG=yourtag-21

# ── WhatsApp (Optional) ────────────────────────────────
WHATSAPP_GROUP_NAMES=Group Name 1,Group Name 2
WHATSAPP_AUTH_FILE=whatsapp-auth.json

# ── Discovery Sources ─────────────────────────────────
DEAL_PAGES=https://www.amazon.in/deals,https://www.amazon.in/gp/goldbox

# ── Keepa API (Price History - Optional) ──────────────
KEEPA_API_KEY=your_keepa_api_key

# ── Multi-Source Ingestion (Optional) ─────────────────
TELEGRAM_SOURCE_ENABLED=false
TELEGRAM_SOURCE_CHANNELS=@channel1,@channel2
WHATSAPP_SOURCE_ENABLED=false
WHATSAPP_SOURCE_GROUPS=group1,group2
AFFILIATE_FEED_ENABLED=false
AFFILIATE_FEED_URLS=https://api.example.com/feed1
DEAL_AGGREGATOR_ENABLED=false
DEAL_AGGREGATOR_SITES=https://dealsite1.com

# ── Rate Limits ────────────────────────────────────────
POSTS_PER_HOUR=20
MAX_DEALS_PER_RUN=50

# ── Monitoring ─────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Environment ────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── Curated Lists Agent ───────────────────────────────
CURATED_LISTS_PORT=3006
CURATED_LIST_PAGES=https://www.amazon.in/gp/bestsellers,https://www.amazon.in/gp/most-gifted
CURATED_LISTS_CRON=0 */4 * * *

# ── Performance & Stability ────────────────────────────
RAM_MANAGEMENT_ENABLED=true
BYPASS_RAM_MANAGEMENT_AND_USE_LOCAL_MODEL=true

# ── Docker Container Memory Limits ─────────────────────
DOCKER_MEM_ANALYSIS=250M
DOCKER_MEM_DISCOVERY=1G
DOCKER_MEM_TELEGRAM=500M
DOCKER_MEM_CURATED_LISTS=500M
